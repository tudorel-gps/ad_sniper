# Copiază acest fișier în .env și completează valorile.

# Token-ul primit de la @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Botul e public: oricine îl poate folosi, fiecare chat cu căutările lui.
# Limite per chat, ca un singur utilizator să nu poată încărca botul:
MAX_SEARCHES_PER_CHAT=10
# secunde minime între două comenzi /check
CHECK_COOLDOWN=60

# Șablonul folosit de /add când primește un termen în loc de URL.
#   {q}     -> "iphone 13" devine "iphone+13"  (parametru de căutare)
#   {query} -> "iphone 13" devine "iphone-13"  (segment de cale, ex. OLX)
SEARCH_TEMPLATE=https://www.publi24.ro/anunturi/?q={q}

# Intervalul dintre verificări (secunde)
CHECK_INTERVAL=300

# Fișierul SQLite (căutări + anunțuri deja trimise)
DB_PATH=sniper.db

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
